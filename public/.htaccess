# Arya Honda /offers/ — static export. No PHP here.
#
# The parent .htaccess sends a request to CodeIgniter only when it matches
# neither a file nor a directory, so everything in this folder is served
# directly by Apache. These rules make that explicit and add caching.

# Serve index.html for /offers/ and /offers/<model>/ even if the server's
# DirectoryIndex does not list it.
DirectoryIndex index.html

# This folder is plain static output; no rewriting needed.
<IfModule mod_rewrite.c>
    RewriteEngine Off
</IfModule>

Options -Indexes

# Next.js fingerprints everything under _next/static, so it can be cached
# permanently. HTML must revalidate or an offer change would not show.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html                     "access plus 0 seconds"
    ExpiresByType text/css                      "access plus 1 year"
    ExpiresByType application/javascript        "access plus 1 year"
    ExpiresByType image/jpeg                    "access plus 1 year"
    ExpiresByType image/png                     "access plus 1 year"
    ExpiresByType image/svg+xml                 "access plus 1 year"
    ExpiresByType font/woff2                    "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2|jpg|jpeg|png|svg)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.html$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

AddType font/woff2 .woff2
