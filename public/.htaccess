# Arya Honda offers — static export. No PHP here.
#
# Used when these pages are served by Apache rather than the Node build:
# either from a subdomain document root, or from public_html/offers/ where
# the parent .htaccess hands off anything matching a real file or directory.

# Serve index.html for / and /<model>/ even if the server's DirectoryIndex
# does not list it.
DirectoryIndex index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Canonical origin: https, no www. Ad destination URLs and the
    # rel="canonical" on every page use that form, so anything else has to
    # land on it rather than serve a duplicate.
    RewriteCond %{HTTPS} !=on
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
</IfModule>

Options -Indexes

# Next.js fingerprints everything under _next/static, so it can be cached
# permanently. HTML must revalidate or an offer change would not show.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html                     "access plus 0 seconds"
    ExpiresByType text/css                      "access plus 1 year"
    ExpiresByType application/javascript        "access plus 1 year"
    ExpiresByType image/jpeg                    "access plus 1 year"
    ExpiresByType image/png                     "access plus 1 year"
    ExpiresByType image/svg+xml                 "access plus 1 year"
    ExpiresByType font/woff2                    "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2|jpg|jpeg|png|svg)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.html$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

AddType font/woff2 .woff2
